{
  "name": "watchlog-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate -m ../database/migrations",
    "migrate:up": "node-pg-migrate up -m ../database/migrations",
    "migrate:down": "node-pg-migrate down -m ../database/migrations",
    "migrate:create": "node-pg-migrate create -m ../database/migrations"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "node-pg-migrate": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
